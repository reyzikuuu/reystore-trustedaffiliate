---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import products from '../data/products.json';
---

<Layout title="Rey Store — Rekomendasi Produk Terbaik Shopee Indonesia" description="Rey Store membantu Anda menemukan produk terbaik dengan harga spesial dan diskon eksklusif langsung dari Shopee Indonesia.">

  <!-- ========== HERO SECTION ========== -->
  <section class="relative bg-gradient-to-br from-shopee-bg via-white to-surface-50 py-16 md:py-0 md:min-h-[85vh]">
    <!-- Decorative blobs -->
    <div class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-shopee-primary/5 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-32 -left-32 h-96 w-96 rounded-full bg-shopee-light/5 blur-3xl"></div>

    <div class="relative mx-auto grid max-w-7xl items-center gap-8 px-4 sm:px-6 md:grid-cols-2 md:gap-12 md:py-20 lg:gap-16">

      <!-- Left: Text Content -->
      <div class="text-center md:text-left">
        <!-- Badge -->
        <div class="animate-fade-in mb-6 inline-flex items-center gap-2 rounded-full border border-shopee-primary/10 bg-white px-4 py-1.5 shadow-sm">
          <span class="h-1.5 w-1.5 rounded-full bg-green-400 animate-pulse"></span>
          <span class="text-xs font-medium text-gray-600">Trusted Shopee Affiliate Partner</span>
        </div>

        <h1 class="animate-slide-up text-balance text-4xl font-extrabold leading-[1.1] tracking-tight text-gray-900 md:text-5xl lg:text-6xl">
          Belanja Lebih Hemat di
          <span class="bg-gradient-to-r from-shopee-primary to-shopee-light bg-clip-text text-transparent">Shopee</span>
        </h1>

        <p class="animate-slide-up-delay mt-5 max-w-lg text-balance text-base leading-relaxed text-gray-500 md:text-lg mx-auto md:mx-0">
          Rekomendasi produk terbaik dengan harga spesial dan diskon eksklusif langsung dari Shopee Indonesia.
        </p>

        <div class="animate-slide-up-delay mt-8 flex flex-col items-center gap-3 sm:flex-row md:justify-start">
          <a href="#produk" class="btn-primary px-8 py-3.5">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
            </svg>
            Lihat Produk
          </a>
          <a href="/disclosure" class="btn-secondary">
            Tentang Kami
          </a>
        </div>

        <!-- Trust indicators -->
        <div class="mt-10 flex flex-wrap items-center justify-center gap-5 text-xs text-gray-400 md:justify-start">
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
            </svg>
            Partner Resmi Shopee
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" />
            </svg>
            Tanpa Biaya Tambahan
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-yellow-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
            </svg>
            Produk Terkurasi
          </span>
        </div>
      </div>

      <!-- Right: Hero Image (desktop only) -->
      <div class="hidden md:flex justify-end">
        <div class="relative animate-fade-in">
          <img
            src="/images/hero-shopping.webp"
            alt="Berbagai produk belanja online keluar dari kotak - elektronik, fashion, dan lainnya"
            loading="eager"
            class="w-full max-w-lg lg:max-w-xl xl:max-w-2xl translate-x-8 lg:translate-x-12 -translate-y-4"
          />
        </div>
      </div>

    </div>
  </section>

  <!-- ========== GRID PRODUK ========== -->
  <section id="produk" class="py-10 md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="text-center">
        <span class="badge mb-3 sm:mb-4">
          <svg class="h-3.5 w-3.5 sm:h-4 sm:w-4 animate-pulse" viewBox="0 0 24 24" fill="none">
            <path d="M12 23C6.48 23 2 18.52 2 13c0-3.43 1.78-6.44 4.46-8.17.38-.25.88.05.83.5-.24 2.07.52 4.27 2.37 5.93a.25.25 0 0 0 .42-.18c.08-1.94.56-4.15 2.02-6.08 1.38-1.82 3.42-3.2 6.18-3.97.43-.12.82.31.67.73C17.86 5.3 18.29 8.3 19.4 10.5c.67 1.32 1.1 2.8 1.1 4.37 0 4.49-3.59 8.13-8.5 8.13Z" fill="url(#fire-grad)"/>
            <path d="M14.5 23c-2.49 0-4.5-2.01-4.5-4.5 0-1.57.67-2.98 1.73-3.97.2-.19.53-.04.52.23-.05 1.43.62 2.76 1.85 3.44a.25.25 0 0 0 .37-.22c.02-.74.26-1.5.73-2.16.5-.7 1.23-1.18 1.91-1.46.24-.1.49.13.42.38-.15.55-.08 1.14.2 1.66.38.7.63 1.5.63 2.35 0 2.27-1.65 4.25-3.86 4.25Z" fill="url(#fire-inner)"/>
            <defs>
              <linearGradient id="fire-grad" x1="12" y1="2" x2="12" y2="23" gradientUnits="userSpaceOnUse">
                <stop stop-color="#FF8A00"/>
                <stop offset="1" stop-color="#EE4D2D"/>
              </linearGradient>
              <linearGradient id="fire-inner" x1="14" y1="12" x2="14" y2="23" gradientUnits="userSpaceOnUse">
                <stop stop-color="#FFD43B"/>
                <stop offset="1" stop-color="#FF8A00"/>
              </linearGradient>
            </defs>
          </svg>
          Pilihan Terbaik
        </span>
        <h2 class="section-heading text-xl md:text-3xl">Produk Pilihan</h2>
        <p class="section-subheading mx-auto max-w-xl text-sm md:text-lg">Produk populer dengan diskon terbaik, dikurasi khusus untuk Anda.</p>
      </div>

      <div class="mt-6 sm:mt-12 grid grid-cols-2 gap-2.5 sm:gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:gap-6">
        {products.map((product) => (
          <article class="card flex flex-col">
            <a href={`/produk/${product.slug}`} class="block relative">
              <img src={product.image} alt={product.name} loading="lazy" class="aspect-[4/5] sm:aspect-square w-full object-cover rounded-t-xl" />
              {product.discount && (
                <span class="badge-discount absolute left-1.5 top-1.5 sm:left-2 sm:top-2 text-[10px] sm:text-xs">-{product.discount}</span>
              )}
            </a>
            <div class="p-2 sm:p-4 flex flex-col flex-1">
              <a href={`/produk/${product.slug}`} class="block mb-1.5 sm:mb-2.5">
                <h3 class="line-clamp-2 text-[11px] sm:text-sm font-medium leading-snug text-gray-800 hover:text-shopee-primary transition-colors">{product.name}</h3>
              </a>

              {product.pros && product.pros.length > 0 && (
                <ul class="mb-1.5 sm:mb-3 space-y-0.5 sm:space-y-1.5 hidden sm:block">
                  {product.pros.slice(0, 2).map((pro: string) => (
                    <li class="flex items-start gap-1.5 text-xs text-gray-500">
                      <svg class="h-3.5 w-3.5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                      </svg>
                      <span class="line-clamp-1">{pro}</span>
                    </li>
                  ))}
                </ul>
              )}

              <div class="mt-auto flex flex-col pt-1 border-t border-gray-50">
                {product.original_price && (
                  <div class="flex items-center gap-1 sm:gap-1.5 mb-0.5">
                    <span class="text-[10px] sm:text-xs font-medium text-gray-400 line-through decoration-gray-400/70">{product.original_price}</span>
                    {product.discount && (
                      <span class="text-[9px] sm:text-[10px] font-bold text-shopee-primary bg-shopee-primary/10 px-1 py-0.5 rounded-sm">-{product.discount}</span>
                    )}
                  </div>
                )}
                <span class="text-sm sm:text-lg font-bold text-shopee-primary leading-none">{product.price}</span>
              </div>

              <a href={product.shopee} target="_blank" rel="noopener noreferrer nofollow" onclick="if(typeof fbq !== 'undefined') fbq('track', 'Lead');" class="btn-primary mt-2 sm:mt-3 block w-full py-1.5 sm:py-2.5 text-[10px] sm:text-xs text-center font-semibold rounded-lg">
                {product.cta_text || "Lihat di Shopee"}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

</Layout>
