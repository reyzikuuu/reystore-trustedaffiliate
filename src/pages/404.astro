---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Halaman Tidak Ditemukan — Rey Store" description="Halaman yang Anda cari tidak ditemukan.">

  <section class="flex flex-1 items-center justify-center py-20 md:py-32">
    <div class="mx-auto max-w-md px-4 text-center">

      <!-- 404 Illustration -->
      <div class="mb-8 text-8xl font-extrabold tracking-tight text-gray-200 md:text-9xl">
        404
      </div>

      <h1 class="text-2xl font-bold text-gray-900 md:text-3xl">
        Halaman Tidak Ditemukan
      </h1>
      <p class="mt-3 text-gray-500">
        Maaf, halaman yang Anda cari tidak ada atau sudah dipindahkan.
      </p>

      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a href="/" class="btn-primary">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
          </svg>
          Kembali ke Beranda
        </a>
        <a href="#produk" class="btn-secondary">
          Lihat Produk
        </a>
      </div>
    </div>
  </section>

</Layout>
