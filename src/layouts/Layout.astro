---
const { title = 'Rey Store — Rekomendasi Produk Terbaik Shopee', description = 'Rey Store membantu Anda menemukan produk terbaik dengan harga spesial dari Shopee Indonesia.' } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#EE4D2D" />

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
    <link rel="manifest" href="/favicon/site.webmanifest">
    <link rel="shortcut icon" href="/favicon/favicon.ico">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://reystoreofficial.my.id/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://reystoreofficial.my.id/images/og-image.jpg" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://reystoreofficial.my.id/" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://reystoreofficial.my.id/images/og-image.jpg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>

    <!-- ========== TRACKING & ANALYTICS ========== -->
    <!-- Google Analytics (GA4) - Ganti G-XXXXXXXXXX dengan Measurement ID Anda -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>

    <!-- Meta Pixel - Ganti 123456789012345 dengan ID Pixel Anda -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '123456789012345');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=123456789012345&ev=PageView&noscript=1"
    /></noscript>
    <!-- ========================================== -->
  </head>
  <body class="min-h-screen flex flex-col bg-surface-50 font-sans antialiased">

    <!-- ========== HEADER ========== -->
    <header class="sticky top-0 z-50 border-b border-gray-100/60 bg-white/80 shadow-header backdrop-blur-xl transition-all duration-300">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3.5 sm:px-6">

        <!-- Logo -->
        <a href="/" class="group flex items-center gap-2.5 transition-opacity hover:opacity-80">
          <img src="/images/logo-reystore.webp" alt="Rey Store" class="h-9 w-9 rounded-xl object-contain" loading="eager" />
          <span class="text-lg font-extrabold tracking-tight text-gray-900">Rey <span class="text-shopee-primary">Store</span></span>
        </a>

        <!-- Nav Desktop -->
        <nav class="hidden items-center gap-1 md:flex">
          <a href="/" class="rounded-lg px-3.5 py-2 text-sm font-medium text-gray-600 transition-colors hover:bg-gray-50 hover:text-gray-900">Beranda</a>
          <a href="#produk" class="rounded-lg px-3.5 py-2 text-sm font-medium text-gray-600 transition-colors hover:bg-gray-50 hover:text-gray-900">Produk</a>
          <a href="/disclosure" class="rounded-lg px-3.5 py-2 text-sm font-medium text-gray-600 transition-colors hover:bg-gray-50 hover:text-gray-900">Disclosure</a>
        </nav>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn" class="inline-flex items-center justify-center rounded-lg p-2 text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700 md:hidden" aria-label="Menu">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      </div>

      <!-- Mobile Nav -->
      <nav id="mobile-menu" class="hidden border-t border-gray-100 bg-white px-4 pb-4 pt-2 md:hidden">
        <a href="/" class="block rounded-lg px-3 py-2.5 text-sm font-medium text-gray-600 transition-colors hover:bg-gray-50 hover:text-gray-900">Beranda</a>
        <a href="#produk" class="block rounded-lg px-3 py-2.5 text-sm font-medium text-gray-600 transition-colors hover:bg-gray-50 hover:text-gray-900">Produk</a>
        <a href="/disclosure" class="block rounded-lg px-3 py-2.5 text-sm font-medium text-gray-600 transition-colors hover:bg-gray-50 hover:text-gray-900">Disclosure</a>
      </nav>
    </header>

    <!-- ========== KONTEN UTAMA ========== -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- ========== FOOTER ========== -->
    <footer class="border-t border-gray-200/60 bg-white">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">

        <!-- Top Footer: Brand + Links -->
        <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">

          <!-- Brand Column -->
          <div class="max-w-xs">
            <a href="/" class="flex items-center gap-2.5">
              <img src="/images/logo-reystore.webp" alt="Rey Store" class="h-8 w-8 rounded-lg object-contain" loading="lazy" />
              <span class="text-base font-bold text-gray-900">Rey <span class="text-shopee-primary">Store</span></span>
            </a>
            <p class="mt-3 text-sm leading-relaxed text-gray-400">
              Rekomendasi produk terbaik dengan harga spesial dari Shopee Indonesia.
            </p>
          </div>

          <!-- Links Column -->
          <div class="flex gap-12 text-sm">
            <div>
              <h4 class="mb-3 text-xs font-semibold uppercase tracking-wider text-gray-400">Halaman</h4>
              <ul class="space-y-2.5">
                <li><a href="/" class="text-gray-500 transition-colors hover:text-shopee-primary">Beranda</a></li>
                <li><a href="#produk" class="text-gray-500 transition-colors hover:text-shopee-primary">Produk</a></li>
              </ul>
            </div>
            <div>
              <h4 class="mb-3 text-xs font-semibold uppercase tracking-wider text-gray-400">Legal</h4>
              <ul class="space-y-2.5">
                <li><a href="/privacy" class="text-gray-500 transition-colors hover:text-shopee-primary">Kebijakan Privasi</a></li>
                <li><a href="/disclosure" class="text-gray-500 transition-colors hover:text-shopee-primary">Disclosure</a></li>
                <li><a href="/syarat" class="text-gray-500 transition-colors hover:text-shopee-primary">Syarat & Ketentuan</a></li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Disclosure Banner -->
        <div class="mt-10 rounded-2xl bg-surface-50 p-4 sm:p-5">
          <p class="text-xs leading-relaxed text-gray-500">
            <span class="font-semibold text-gray-600">⚡ Disclosure:</span>
            Situs ini berisi link afiliasi Shopee. Jika Anda membeli melalui link tersebut, kami mungkin menerima komisi tanpa biaya tambahan untuk Anda. Lihat selengkapnya di halaman
            <a href="/disclosure" class="font-medium text-shopee-primary underline decoration-shopee-primary/30 underline-offset-2 transition-colors hover:text-shopee-dark hover:decoration-shopee-dark">Disclosure</a>.
          </p>
        </div>

        <!-- Bottom Bar -->
        <div class="mt-8 flex flex-col gap-4 border-t border-gray-100 pt-8 text-xs text-gray-400 sm:flex-row sm:items-center sm:justify-between">
          <div class="space-y-1">
            <p>Dikelola oleh: <span class="font-medium text-gray-500">Virman Adipura</span></p>
            <p>Lokasi: Mangunreja, Tasikmalaya</p>
            <p>Kontak: <a href="mailto:virmanadipuraaaa@gmail.com" class="font-medium text-gray-500 transition-colors hover:text-shopee-primary">virmanadipuraaaa@gmail.com</a></p>
          </div>
          <p class="text-gray-300">
            &copy; {new Date().getFullYear()} reystoreofficial.my.id — Virman Adipura
          </p>
        </div>

      </div>
    </footer>

    <!-- Mobile Menu Script -->
    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
    </script>
    <style is:global>
      .hide-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </body>
</html>
