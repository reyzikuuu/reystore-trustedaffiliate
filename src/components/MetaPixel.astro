---
interface Props {
  eventName?: 'PageView' | 'ViewContent' | 'AddToCart' | 'InitiateCheckout' | 'Purchase' | 'Lead';
  price?: number;
  sku?: string | string[];
  productName?: string;
}

const { eventName = 'PageView', price = 0, sku = '', productName = '' } = Astro.props;

// Meta Pixel ID
const pixelId = '1992327198020900';
---

<!-- Meta Pixel Code -->
<script is:inline define:vars={{ pixelId, eventName, price, sku, productName }}>
  !function(f,b,e,v,n,t,s)
  {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};
  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
  n.queue=[];t=b.createElement(e);t.async=!0;
  t.src=v;s=b.getElementsByTagName(e)[0];
  s.parentNode.insertBefore(t,s)}(window, document,'script',
  'https://connect.facebook.net/en_US/fbevents.js');

  // Advanced Matching - Placeholder
  // Nantinya bisa diisi dengan data user yang login (harus di-hash SHA256)
  const advancedMatching = {
    em: '', // sha256(email)
    ph: '', // sha256(phone)
    external_id: ''
  };

  // Init fbq dengan Advanced Matching
  fbq('init', pixelId, advancedMatching);

  // Helper untuk baca cookie fbp & fbc
  function getCookie(name) {
    const value = `; ${document.cookie}`;
    const parts = value.split(`; ${name}=`);
    if (parts.length === 2) return parts.pop().split(';').shift();
    return '';
  }

  const fbp = getCookie('_fbp');
  const fbc = getCookie('_fbc');

  // Generate Unique Event ID untuk keperluan deduplikasi (Browser vs Server)
  const eventId = crypto.randomUUID();
  
  let customData = {};
  if (['ViewContent', 'AddToCart', 'Purchase'].includes(eventName)) {
    const contentIds = Array.isArray(sku) ? sku : (sku ? [sku] : []);
    customData = {
      content_name: productName,
      content_type: 'product',
      content_ids: contentIds,
      value: Number(price), // Value harus berupa number tanpa format (contoh: 1250000)
      currency: 'IDR'
    };
  }

  // 1. Kirim event via Browser (Pixel) dengan eventID untuk deduplikasi
  fbq('track', eventName, customData, { eventID: eventId });

  // 2. Kirim event via Server (Conversions API) ke endpoint lokal
  const payload = {
    event_name: eventName,
    event_id: eventId,
    event_source_url: window.location.href,
    fbp: fbp,
    fbc: fbc,
    ...customData
  };

  // Fetch ke Astro Endpoint secara asynchronous
  fetch('/api/meta-capi', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify(payload)
  }).catch(err => console.error('Failed to send to CAPI:', err));

</script>
<noscript><img height="1" width="1" style="display:none"
  src={`https://www.facebook.com/tr?id=${pixelId}&ev=${eventName}&noscript=1`}
/></noscript>
<!-- End Meta Pixel Code -->
